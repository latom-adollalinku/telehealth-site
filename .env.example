# Cal.com Booking (set up at cal.com)
NEXT_PUBLIC_CAL_LINK=latom-wellness/consultation

# Helcim Card Processing (get at helcim.com/developers)
# NOTE: Server-side only. Do NOT prefix with NEXT_PUBLIC_ — that exposes the token to the browser bundle.
# If you need a publishable client token, name it explicitly: HELCIM_PUBLISHABLE_TOKEN (still no NEXT_PUBLIC_).
HELCIM_API_KEY=your_helcim_server_api_key_here

# Admin token: required for /api/admin/* routes (bookings, generate-invoice).
# Set to a long random string. Generate with: openssl rand -hex 32
ADMIN_SECRET_TOKEN=your_long_random_admin_token_here

# Protocol unlock secret: required for /api/admin/unlock route.
# Generate with: openssl rand -hex 32
PROTOCOL_UNLOCK_SECRET=your_long_random_unlock_secret_here

# PayPal Integration (get at developer.paypal.com)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_client_id_here
NEXT_PUBLIC_PAYPAL_MODE=sandbox

# Zelle Payment Details (your practice account)
NEXT_PUBLIC_ZELLE_EMAIL=pay@latomwellness.com

# Venmo Payment Details (your practice account)
NEXT_PUBLIC_VENMO_USERNAME=latom-wellness

# Practice Contact Info
NEXT_PUBLIC_PHONE=6784040730

# Application URLs
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Notification Email (for booking requests)
NOTIFICATION_EMAIL=anesbrothers@gmail.com

# Email Service (SendGrid, Resend, etc. - optional)
SENDGRID_API_KEY=your_sendgrid_api_key_here
RESEND_API_KEY=your_resend_api_key_here

# Google Sheets — Telehealth Payment Log
# GOOGLE_SERVICE_ACCOUNT_KEY: base64-encode your service account JSON key
#   macOS: base64 -i service-account.json | pbcopy
# GOOGLE_SHEETS_PAYMENT_LOG_ID: the ID from the sheet URL (between /d/ and /edit)
GOOGLE_SERVICE_ACCOUNT_KEY=your_base64_service_account_key_here
GOOGLE_SHEETS_PAYMENT_LOG_ID=your_sheet_id_here
